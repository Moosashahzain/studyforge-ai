# Copy to .env (never commit .env) — see docs/SETUP.md
PORT=3000

# AI model (optional). Without this, the app runs in clearly-labelled demo mode.
# Any OpenAI-compatible chat-completions endpoint works.
STUDYFORGE_AI_API_KEY=
STUDYFORGE_AI_BASE_URL=https://api.openai.com/v1
STUDYFORGE_AI_MODEL=gpt-4o-mini

# Contact form delivery (optional). Without this, the portfolio contact form
# runs in demo mode (validates, but does not send).
CONTACT_ENABLED=0
CONTACT_LOG=./server/inbox.jsonl
